meta {
  name: Get Category By ID
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/Categoria/{{categoryId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{userToken}}
}

vars:pre-request {
  categoryId: 3fa85f64-5717-4562-b3fc-2c963f66afa6
}

tests {
  test("Status should be 200 or 404", function() {
    expect([200, 404]).to.include(res.status);
  });
}